\n\n  .container {\n    max-width: 1536px;\n  }\n}\n  .container-page {\n    width: 100%;\n    max-width: 1280px;\n    margin-inline: auto;\n    padding-inline: clamp(1.25rem, 4vw, 3rem);\n  }\n\n  /*\n   * On large displays a hard 1280px cap left the hero rig at ~590px with wide\n   * empty margins, so the software read as small on exactly the screens with\n   * the most room for it. Step the container up instead of stretching to full\n   * width, which would break the measure of body copy.\n   */\n  /*\n   * Visual-led sections get a wider track than text-led ones: product\n   * screenshots read better with more room, body copy does not.\n   */\n  .container-page--wide {\n    max-width: 1400px;\n  }\n\n  @media (min-width: 1536px) {\n    .container-page {\n      max-width: 1440px;\n    }\n\n    .container-page--wide {\n      max-width: 1520px;\n    }\n  }\n\n  @media (min-width: 1800px) {\n    .container-page {\n      max-width: 1560px;\n    }\n  }\n\n  .eyebrow {\n  font-size: 0.6875rem;\n  line-height: 1rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.18em;\n  --tw-text-opacity: 1;\n  color: rgb(20 138 77 / var(--tw-text-opacity, 1));\n}\n\n  .rule {\n  height: 1px;\n  width: 100%;\n  --tw-bg-opacity: 1;\n  background-color: rgb(233 238 234 / var(--tw-bg-opacity, 1));\n}\n\n  /*\n   * A&I volume slider.\n   *\n   * A real <input type=\"range\">, restyled rather than replaced, so it keeps\n   * keyboard operation, the screen-reader value and the native drag behaviour.\n   * The track is a hairline in the A&I palette; the thumb is a small light.\n   */\n  .ai-volume-slider {\n    -webkit-appearance: none;\n    -moz-appearance: none;\n         appearance: none;\n    height: 1.25rem;\n    background: transparent;\n  }\n\n  .ai-volume-slider::-webkit-slider-runnable-track {\n    height: 1px;\n    border-radius: 999px;\n    background: rgba(220, 239, 255, 0.28);\n  }\n\n  .ai-volume-slider::-moz-range-track {\n    height: 1px;\n    border-radius: 999px;\n    background: rgba(220, 239, 255, 0.28);\n  }\n\n  .ai-volume-slider::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    appearance: none;\n    width: 0.625rem;\n    height: 0.625rem;\n    margin-top: -0.3125rem;\n    border: 0;\n    border-radius: 999px;\n    background: rgb(186 222 255);\n    box-shadow: 0 0 10px -1px rgba(126, 200, 255, 0.85);\n  }\n\n  .ai-volume-slider::-moz-range-thumb {\n    width: 0.625rem;\n    height: 0.625rem;\n    border: 0;\n    border-radius: 999px;\n    background: rgb(186 222 255);\n    box-shadow: 0 0 10px -1px rgba(126, 200, 255, 0.85);\n  }\n\n  .ai-volume-slider:focus-visible {\n    outline: none;\n  }\n\n  .ai-volume-slider:focus-visible::-webkit-slider-thumb {\n    box-shadow:\n      0 0 0 3px rgba(126, 200, 255, 0.45),\n      0 0 10px -1px rgba(126, 200, 255, 0.85);\n  }\n\n  .ai-volume-slider:focus-visible::-moz-range-thumb {\n    box-shadow:\n      0 0 0 3px rgba(126, 200, 255, 0.45),\n      0 0 10px -1px rgba(126, 200, 255, 0.85);\n  }\n\n  .ai-glass {\n    background: linear-gradient(\n      140deg,\n      rgba(220, 239, 255, 0.13) 0%,\n      rgba(126, 200, 255, 0.07) 45%,\n      rgba(247, 241, 232, 0.05) 100%\n    );\n    backdrop-filter: blur(16px) saturate(135%);\n    -webkit-backdrop-filter: blur(16px) saturate(135%);\n    border: 1px solid rgba(126, 200, 255, 0.22);\n    box-shadow:\n      0 12px 40px -24px rgba(12, 27, 41, 0.9),\n      inset 0 1px 0 rgba(255, 255, 255, 0.08);\n  }\n\n  /* Card surface used by memory panels and stat plates. */\n  .ai-surface {\n    background: linear-gradient(\n      160deg,\n      rgba(23, 50, 77, 0.62) 0%,\n      rgba(17, 37, 56, 0.72) 100%\n    );\n    border: 1px solid rgba(220, 239, 255, 0.14);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n  }\n\n  /*\n   * Where a scene comes to rest when it is jumped to.\n   *\n   * The previous offset was exactly the height of the bar, so a scene title\n   * landed flush against it with nothing between them. A title needs to arrive\n   * inside the reading area, not level with the furniture, so the anchor clears\n   * the bar and then some.\n   */\n  .ai-scene-anchor {\n    scroll-margin-top: calc(var(--nav-height) + 1.5rem);\n  }\n\n  @media (min-width: 640px) {\n    .ai-scene-anchor {\n      scroll-margin-top: calc(var(--nav-height) + 2.5rem);\n    }\n  }\n\n  /*\n   * A scrim under the fixed bar.\n   *\n   * The sky brightens toward sunrise in the later scenes, and over the bright\n   * end of that range the bar's own glass was not enough separation. This is a\n   * gradient that fades to nothing well before the reading area, so it darkens\n   * the strip behind the controls without darkening the experience.\n   */\n  .ai-nav-scrim {\n    background: linear-gradient(\n      to bottom,\n      rgba(12, 27, 41, 0.55) 0%,\n      rgba(12, 27, 41, 0.28) 45%,\n      rgba(12, 27, 41, 0) 100%\n    );\n  }\n\n  /* Keeps white type legible wherever the sky brightens behind it. */\n  .ai-legible,\n  .ai-scene-title {\n    text-shadow: 0 1px 24px rgba(12, 27, 41, 0.55), 0 1px 3px rgba(12, 27, 41, 0.4);\n  }\n\n  /*\n   * The same protection for the SMALL type, which needs it more.\n   *\n   * Every technical label in the private flow is 9–10px mono at 55–60% alpha.\n   * That is a deliberate, quiet register and it reads beautifully over deep\n   * night — but the sky warms toward sunrise through Life, Convergence, the\n   * Letter and the Finale, and over the bright end of that range five of these\n   * labels fell below a comfortable contrast. A tight shadow restores the edge\n   * without touching the colour, so the register is unchanged and nothing in\n   * the experience gets darker.\n   */\n  .ai-private .font-mono {\n    text-shadow: 0 1px 10px rgba(12, 27, 41, 0.6), 0 1px 2px rgba(12, 27, 41, 0.45);\n  }\n\n  /* A&I type system: Anuphan softens body copy while Noto Serif Thai gives\n     emotional headings a warmer, more lyrical shape. Both are scoped to the\n     private flow; corporate typography stays on IBM Plex Sans Thai. */\n  /*\n   * SOFTER, ON PURPOSE.\n   *\n   * The owner's note was that the emotional Thai type read as rigid. Thai has\n   * no lowercase and no italic, so the only levers are weight, leading and\n   * tracking — and the previous settings pushed all three toward \"poster\":\n   * tight 1.16 leading with the -0.01em tracking inherited from .thai-display,\n   * at up to 4rem.\n   *\n   * This loosens the line, releases the negative tracking, and caps the size a\n   * little lower. It matters more now than it did: eleven of the nineteen places\n   * have no photograph, so those scenes are carried entirely by this type.\n   *\n   * This refinement introduces the private-only pairing intentionally: three\n   * practical weights per family, with Latin and numeric display copy still\n   * led by Cormorant Garamond.\n   */\n  /*\n   * NEVER `@apply font-thai` / `font-display` / `font-sans` BELOW THIS LINE.\n   *\n   * `@apply <utility>` copies every declaration block that defines that\n   * utility — including the scoped `.ai-private .font-thai` rule in the base\n   * layer above. Tailwind re-emits that rule with the applying selector\n   * substituted, producing `.ai-private .ai-scene-title { font-family:\n   * var(--font-ai-body) }` at the component layer, i.e. LATER in the sheet and\n   * at identical specificity. The result was that every A&I heading silently\n   * rendered in the body face: the intended rule was present, correct, and\n   * simply outranked by a copy of itself.\n   *\n   * So the A&I component classes take their face from the variable directly.\n   * The variable is the single source of truth; the utility is for markup only.\n   */\n  .ai-scene-title {\n  font-weight: 300;\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n    font-family: var(--font-ai-display);\n    font-size: clamp(1.75rem, 4.4vw, 3.5rem);\n    line-height: 1.32;\n    letter-spacing: 0.005em;\n}\n\n  .ai-body {\n  color: rgb(255 255 255 / 0.7);\n    font-family: var(--font-ai-body);\n    font-size: clamp(1rem, 1.45vw, 1.1875rem);\n    /* Thai tone marks sit above the line; 1.95 stops them crowding the row\n       above in a multi-line emotional paragraph. */\n    line-height: 1.95;\n    letter-spacing: 0.005em;\n}\n\n  @media (min-width: 1024px) {\n    .ai-one-line-desktop {\n      max-width: none;\n      white-space: nowrap;\n    }\n  }\n\n  /*\n   * The monospaced scene label. Still technical — that contrast is part of the\n   * identity — but dimmer and slightly smaller, so it frames the emotional copy\n   * instead of competing with it.\n   */\n\n  .ai-wordmark {\n  font-weight: 300;\n  text-transform: uppercase;\n    font-family: var(--font-ai-latin);\n    letter-spacing: 0.12em;\n    text-shadow: 0 0 30px rgba(126, 200, 255, 0.2);\n}\n\n  /*\n   * MICRO-INTERACTIONS — restrained on purpose.\n   *\n   * `.ai-lift` is a photograph noticing the pointer: a two-pixel rise and a\n   * slightly warmer shadow, nothing that moves the layout. `.ai-sweep` passes\n   * one slow band of light across a frame on hover. Both are pointer-only, so\n   * a touch device never gets a hover state stuck on, and both are inert under\n   * reduced motion because the transition duration is clamped to nothing.\n   */\n  @media (hover: hover) and (pointer: fine) {\n    .ai-lift {\n      transition:\n        transform 620ms var(--ease-entrance),\n        box-shadow 620ms var(--ease-entrance);\n      will-change: transform;\n    }\n\n    .ai-lift:hover {\n      transform: translate3d(0, -2px, 0);\n      box-shadow: 0 34px 90px -40px rgba(7, 21, 35, 0.95), 0 0 54px -22px var(--ai-glow);\n    }\n\n    .ai-sweep::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      z-index: 2;\n      translate: -110% 0;\n      background: linear-gradient(\n        105deg,\n        transparent 38%,\n        rgba(220, 239, 255, 0.14) 50%,\n        transparent 62%\n      );\n      transition: translate 1400ms var(--ease-entrance);\n    }\n\n    .ai-sweep:hover::after {\n      translate: 110% 0;\n    }\n  }\n\n  .ai-handwritten {\n    font-family: var(--font-ai-latin);\n    font-style: italic;\n    letter-spacing: 0.01em;\n  }\n\n  /* Reusable photo grammar. Each scene can choose a role without changing the\n     image component or applying a destructive filter to future real photos. */\n  .ai-frame-cinematic,\n  .ai-frame-memory,\n  .ai-frame-polaroid,\n  .ai-frame-orbit {\n    position: relative;\n    isolation: isolate;\n    background: rgba(23, 50, 77, 0.58);\n    box-shadow: 0 28px 80px -38px rgba(7, 21, 35, 0.92), 0 0 42px -24px var(--ai-glow);\n  }\n\n  .ai-frame-cinematic {\n    overflow: hidden;\n    border: 1px solid rgba(220, 239, 255, 0.18);\n    border-radius: 1.5rem;\n  }\n\n  .ai-frame-memory {\n    overflow: hidden;\n    border: 1px solid rgba(247, 241, 232, 0.38);\n    border-radius: 1rem;\n    box-shadow: 0 24px 65px -35px rgba(7, 21, 35, 0.95), 0 0 38px -25px var(--ai-glow);\n  }\n\n  .ai-frame-polaroid {\n    overflow: hidden;\n    padding: 0.45rem 0.45rem 1.85rem;\n    border: 1px solid rgba(247, 241, 232, 0.34);\n    border-radius: 0.75rem;\n    background: rgba(247, 241, 232, 0.12);\n  }\n\n  .ai-frame-orbit {\n    overflow: hidden;\n    border: 1px solid rgba(126, 200, 255, 0.34);\n    border-radius: 9999px;\n    box-shadow: 0 0 50px -20px rgba(126, 200, 255, 0.65);\n  }\n\n  .ai-photo-spill::before {\n    content: '';\n    position: absolute;\n    z-index: -1;\n    inset: -14%;\n    border-radius: inherit;\n    background: radial-gradient(circle at 50% 60%, rgba(126, 200, 255, 0.2), transparent 65%);\n    filter: blur(24px);\n    opacity: 0.72;\n    pointer-events: none;\n  }\n\n  /*\n   * SHOOTING STAR.\n   *\n   * A bright head with a tail that fades behind it, travelling along its own\n   * rotated axis. Kept dim on purpose: it must read as atmosphere at the edge\n   * of vision, never as something competing with a photograph or a line of\n   * text. One element, one transform, no repaint of anything else.\n   */\n  .shooting-star {\n    position: absolute;\n    height: 1.5px;\n    border-radius: 999px;\n    transform-origin: left center;\n    background: linear-gradient(\n      90deg,\n      rgba(255, 255, 255, 0) 0%,\n      rgba(186, 222, 255, 0.35) 45%,\n      rgba(255, 255, 255, 0.95) 92%,\n      rgba(255, 255, 255, 1) 100%\n    );\n    box-shadow: 0 0 6px rgba(186, 222, 255, 0.55);\n    opacity: 0;\n    animation-name: shooting-star-run;\n    animation-timing-function: cubic-bezier(0.32, 0, 0.67, 0);\n    animation-fill-mode: forwards;\n  }\n\n  @keyframes shooting-star-run {\n    0% {\n      opacity: 0;\n      translate: -8vw -3vw;\n      scale: 0.4 1;\n    }\n    12% {\n      opacity: 0.85;\n    }\n    70% {\n      opacity: 0.7;\n    }\n    100% {\n      opacity: 0;\n      translate: 34vw 12vw;\n      scale: 1 1;\n    }\n  }\n\n  /*\n   * SECRET WHISPER.\n   *\n   * The resting state is VISIBLE. The keyframe only adds the rise on top, so a\n   * whisper whose animation never runs — throttled tab, stalled compositor,\n   * reduced motion — is simply readable instead of invisible. It lives for a few\n   * seconds and then unmounts, so an entrance that gates opacity would mean it\n   * was never seen at all.\n   */\n  .secret-whisper {\n    pointer-events: none;\n    -webkit-user-select: none;\n       -moz-user-select: none;\n            user-select: none;\n    white-space: nowrap;\n    opacity: 1;\n    font-family: IBM Plex Sans Thai, Inter, sans-serif;\n    font-size: 0.8125rem;\n    line-height: 1.6;\n    color: rgb(247 241 232 / 0.85);\n    text-shadow: 0 0 18px rgba(126, 200, 255, 0.55);\n    /*\n     * NOTE THE ABSENCE OF `both`, AND OF OPACITY IN THE KEYFRAME.\n     *\n     * `fill-mode: both` re-applies the `from` state outside the animation, which\n     * put the element back at opacity 0 whenever the animation did not progress\n     * — measured exactly that. And a THROTTLED animation holds whatever frame it\n     * stalled on, so even without a fill mode, animating opacity would still be\n     * able to hide the text.\n     *\n     * So opacity and blur are never animated here. Only `translate` is, and a\n     * rise that stalls leaves the whisper eight pixels low and perfectly\n     * readable. There is no state of this animation, running or not, in which\n     * the words are invisible.\n     */\n    animation: secret-whisper-in 700ms cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  /*\n   * Uses the independent `translate` property, NOT `transform`.\n   *\n   * Several of these whispers are centred with Tailwind's `-translate-x-1/2`,\n   * which compiles to `transform`. Animating `transform` here would overwrite\n   * that centring for the life of the animation and — with `fill-mode: both` —\n   * keep it overwritten afterwards, knocking the text off-centre. `translate`\n   * composes with `transform` instead of replacing it.\n   */\n  @keyframes pulse-slow {\n    0%, 100% { opacity: 0.35; }\n    50% { opacity: 0.85; }\n  }\n\n  .animate-pulse-slow {\n    animation: pulse-slow 2s ease-in-out infinite;\n  }\n\n  @keyframes secret-whisper-in {\n    from {\n      translate: 0 8px;\n    }\n    to {\n      translate: 0 0;\n    }\n  }\n\n  /*\n   * A&I CONTROLS.\n   *\n   * `touch-action: manipulation` removes the browser's double-tap-to-zoom wait,\n   * which is what makes a tap feel like it lands late on a phone even when the\n   * handler fires immediately.\n   *\n   * Every control also needs a PRESSED state, not just a hover one: hover does\n   * not exist on touch, so without this a tap gives no feedback at all until the\n   * scene reacts. The scale is small and the timing short - these are quiet\n   * controls in a cinematic scene, not app buttons.\n   */\n  .ai-button-primary,\n  .ai-button-secondary,\n  .ai-button-text {\n  position: relative;\n  display: inline-flex;\n  min-height: 2.75rem;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  border-radius: 999px;\n  padding-left: 1.5rem;\n  padding-right: 1.5rem;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 520ms;\n    font-family: var(--font-ai-body);\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n}\n\n  .ai-button-primary:active,\n  .ai-button-secondary:active,\n  .ai-button-text:active {\n    transform: scale(0.975);\n    transition-duration: 120ms;\n  }\n\n  .ai-button-primary:disabled,\n  .ai-button-secondary:disabled,\n  .ai-button-text:disabled {\n  cursor: default;\n  opacity: 0.4;\n    transform: none;\n}\n\n  /* Shared pressed response for the smaller A&I controls (nav, toggles, cards). */\n  .ai-pressable {\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n    transition:\n      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),\n      opacity 180ms cubic-bezier(0.16, 1, 0.3, 1),\n      background-color 180ms cubic-bezier(0.16, 1, 0.3, 1),\n      border-color 180ms cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .ai-pressable:active {\n    transform: scale(0.94);\n    transition-duration: 110ms;\n  }\n\n  .ai-pressable:disabled:active {\n    transform: none;\n  }\n\n  .ai-button-primary {\n  border-width: 1px;\n  border-color: rgb(220 239 255 / 0.55);\n  --tw-bg-opacity: 1;\n  background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(17 37 56 / var(--tw-text-opacity, 1));\n  --tw-shadow: 0 0 60px -12px rgba(126,200,255,0.45);\n  --tw-shadow-colored: 0 0 60px -12px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n  --tw-shadow-color: #CFE8FF;\n  --tw-shadow: var(--tw-shadow-colored);\n}\n\n  .ai-button-primary:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 14px 44px -20px rgba(126, 200, 255, 0.8);\n  }\n\n  .ai-button-secondary {\n  border-width: 1px;\n  border-color: rgb(196 228 255 / 0.3);\n  background-color: rgb(126 200 255 / 0.05);\n  color: rgb(255 255 255 / 0.8);\n}\n\n  .ai-button-secondary:hover {\n  border-color: rgb(196 228 255 / 0.6);\n  background-color: rgb(126 200 255 / 0.1);\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n}\n\n  .ai-button-text {\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n  color: rgb(255 255 255 / 0.55);\n}\n\n  .ai-button-text:hover {\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n    transform: translateX(2px);\n}\n\n  .ai-warm-wash {\n    background:\n      radial-gradient(70% 60% at 50% 86%, rgba(247, 241, 232, 0.2), transparent 70%),\n      radial-gradient(42% 36% at 78% 25%, rgba(235, 217, 188, 0.12), transparent 75%);\n  }\n\n  .text-gradient-ai,\n  .ai-wordmark {\n    background: linear-gradient(120deg, #ffffff 0%, #7ec8ff 45%, #ebd9bc 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  .hairline-grid {\n    background-image:\n      linear-gradient(to right, rgba(10, 12, 11, 0.045) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(10, 12, 11, 0.045) 1px, transparent 1px);\n    background-size: 72px 72px;\n  }\n\n  .corporate-shell {\n    isolation: isolate;\n    background: #f7f9f7;\n  }\n\n  .corporate-background {\n    position: fixed;\n    inset: 0;\n    z-index: -2;\n    overflow: hidden;\n    pointer-events: none;\n    /* Neutral base only — each section paints its own ground on top. */\n    background: #f7f9f7;\n  }\n\n  .corporate-orb { position:absolute; border-radius:999px; filter:blur(110px); opacity:.22; }\n  .corporate-orb--one { width:46rem; height:46rem; right:-18rem; top:-16rem; background:#b2e9c8; }\n  .corporate-noise { position:absolute; inset:0; opacity:.018; background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E\"); }\n\n\n  /* ===================================================================== */\n  /* PDA BLISS — section identity system                                   */\n  /* ===================================================================== */\n  /*\n   * Each major section owns its ground so the page reads as a sequence of\n   * places rather than one gradient with content on top. `.sect` sets the\n   * base; the modifier paints the identity. All of them are CSS only.\n   */\n\n  .sect {\n    position: relative;\n    isolation: isolate;\n  }\n\n  /* Layer helper: every decorative layer inside a section sits behind content. */\n  .sect-layer {\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n    overflow: hidden;\n  }\n\n  /* --- hero: deep green aurora + network ------------------------------- */\n  .sect--hero {\n    background:\n      radial-gradient(120% 90% at 78% 8%, rgba(29, 170, 97, 0.16) 0%, transparent 58%),\n      radial-gradient(90% 70% at 12% 96%, rgba(11, 81, 55, 0.1) 0%, transparent 62%),\n      linear-gradient(180deg, #f7f9f7 0%, #ffffff 46%, #f4f8f5 100%);\n  }\n\n  /* --- system universe: technical mesh on near-black green ------------- */\n  .sect--mesh {\n    background:\n      radial-gradient(70% 58% at 62% 45%, rgba(53, 201, 111, 0.26) 0%, transparent 62%),\n      linear-gradient(165deg, #06412e 0%, #063b2a 46%, #052f22 100%);\n  }\n\n  .mesh-lines {\n    background-image:\n      linear-gradient(rgba(53, 201, 111, 0.09) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(53, 201, 111, 0.09) 1px, transparent 1px);\n    background-size: 64px 64px;\n    mask-image: radial-gradient(70% 60% at 50% 45%, black, transparent 78%);\n    -webkit-mask-image: radial-gradient(70% 60% at 50% 45%, black, transparent 78%);\n  }\n\n  /* --- services: clean white grid -------------------------------------- */\n  .sect--grid {\n    background: #ffffff;\n  }\n\n  .grid-lines {\n    background-image:\n      linear-gradient(rgba(6, 59, 42, 0.05) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(6, 59, 42, 0.05) 1px, transparent 1px);\n    background-size: 96px 96px;\n    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);\n    -webkit-mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);\n  }\n\n  /* --- solutions: off-white moving line field -------------------------- */\n  .sect--field {\n    background: linear-gradient(180deg, #f7f9f7 0%, #eff3f0 50%, #f7f9f7 100%);\n  }\n\n  .field-lines {\n    background-image: repeating-linear-gradient(\n      100deg,\n      rgba(6, 59, 42, 0.055) 0px,\n      rgba(6, 59, 42, 0.055) 1px,\n      transparent 1px,\n      transparent 26px\n    );\n    mask-image: radial-gradient(80% 70% at 50% 50%, black, transparent 82%);\n    -webkit-mask-image: radial-gradient(80% 70% at 50% 50%, black, transparent 82%);\n  }\n\n  /* --- work: near-black green with a glow ------------------------------ */\n  .sect--deep {\n    background:\n      radial-gradient(85% 65% at 22% 4%, rgba(53, 201, 111, 0.18) 0%, transparent 58%),\n      linear-gradient(170deg, #07281d 0%, #04261b 55%, #06231a 100%);\n  }\n\n  /* --- process: architectural line system ------------------------------ */\n  .sect--blueprint {\n    background: linear-gradient(180deg, #ffffff 0%, #f7f9f7 100%);\n  }\n\n  /* --- about: bright minimal ------------------------------------------- */\n  .sect--bright {\n    background: #ffffff;\n  }\n\n  /* --- why us: cream with a green cast ---------------------------------- */\n  .sect--cream {\n    background:\n      radial-gradient(70% 60% at 18% 20%, rgba(53, 201, 111, 0.09) 0%, transparent 62%),\n      l