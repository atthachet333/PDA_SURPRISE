lock` by default. (https://github.com/mozdevs/cssremedy/issues/14)\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\n   This can trigger a poorly considered lint error in some tools but is included by design.\n*/\n\nimg,\nsvg,\nvideo,\ncanvas,\naudio,\niframe,\nembed,\nobject {\n  display: block; /* 1 */\n  vertical-align: middle; /* 2 */\n}\n\n/*\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\n*/\n\nimg,\nvideo {\n  max-width: 100%;\n  height: auto;\n}\n\n/* Make elements with the HTML hidden attribute stay hidden by default */\n[hidden]:where(:not([hidden=\"until-found\"])) {\n  display: none;\n}\n  :root {\n    --page-bg: #ffffff;\n    --page-fg: #0a0c0b;\n    --ease-entrance: cubic-bezier(0.16, 1, 0.3, 1);\n    /*\n     * The real rendered height of the A&I bar, measured: the glass pill plus\n     * its top offset. It was 72px here while the bar rendered at 112px, and\n     * nothing read the variable at all — the scroll offsets were hard-coded\n     * Tailwind classes that happened to agree. Now there is one number, and\n     * `.ai-scene-anchor` is the only thing that consumes it.\n     */\n    --nav-height: 112px;\n\n    /*\n     * THE A&I TYPE SYSTEM.\n     *\n     * Declared on :root rather than on `body[data-theme='ai']`, which is where\n     * they were and which was the bug. `.ai-private` is the scope that opts a\n     * subtree into these faces, and the Memory Gate carries `.ai-private`\n     * WITHOUT ever setting `data-theme` — so on that page the variables\n     * resolved to nothing, `font-family:` was dropped as invalid, and the text\n     * silently inherited IBM Plex Sans Thai from `body`. A font stack is inert\n     * until something asks for it, so there is no reason to gate it on a theme.\n     *\n     *   body     Anuphan — a soft modern Thai sans, humanist rather than grotesk.\n     *   display  Noto Serif Thai — the emotional headings. Thai has no italic\n     *            and no lowercase, so a serif is the only way to change VOICE\n     *            rather than just size.\n     *   latin    Cormorant Garamond for Latin words, dates and numerals, which\n     *            is already the experience's signature and stays.\n     */\n    --font-ai-body: 'Anuphan', 'IBM Plex Sans Thai', Inter, sans-serif;\n    --font-ai-display: 'Noto Serif Thai', 'Anuphan', Georgia, serif;\n    --font-ai-latin: 'Cormorant Garamond', 'Noto Serif Thai', Georgia, serif;\n  }\n\n  * {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  html {\n    position: relative;\n    scroll-behavior: auto;\n  }\n\n  html.lenis,\n  html.lenis body {\n    height: auto;\n  }\n\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n\n  body {\n    margin: 0;\n    background: var(--page-bg);\n    color: var(--page-fg);\n    font-family: IBM Plex Sans Thai, Inter, system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    text-rendering: optimizeLegibility;\n    overflow-x: hidden;\n  }\n\n  /* The private experience paints its own celestial backdrop. */\n  body[data-theme='ai'] {\n    --page-bg: #112538;\n    --page-fg: #ffffff;\n    --ai-sky: #7ec8ff;\n    --ai-sky-soft: #dcefff;\n    --ai-cream: #f7f1e8;\n    --ai-navy: #17324d;\n    --ai-ink: #112538;\n    --ai-white: #ffffff;\n    --ai-champagne: #ebd9bc;\n    --ai-glow: rgba(126, 200, 255, 0.32);\n  }\n\n  @media (pointer: fine) and (hover: hover) {\n    body.corporate-cursor-active,\n    body.corporate-cursor-active * {\n      cursor: none !important;\n    }\n  }\n\n  /* Only applied while the custom cursor component is mounted and running. */\n  body.ai-cursor-active,\n  body.ai-cursor-active * {\n    cursor: none !important;\n  }\n\n  /* A keyboard user always gets the native cursor back. */\n  body.ai-cursor-active:focus-within :focus-visible {\n    cursor: auto !important;\n  }\n\n  ::-moz-selection {\n    background: rgba(18, 144, 86, 0.18);\n  }\n\n  ::selection {\n    background: rgba(18, 144, 86, 0.18);\n  }\n\n  body[data-theme='ai'] ::-moz-selection {\n    background: rgba(107, 182, 241, 0.3);\n  }\n\n  body[data-theme='ai'] ::selection {\n    background: rgba(107, 182, 241, 0.3);\n  }\n\n  :focus-visible {\n    outline: 2px solid #1DAA61;\n    outline-offset: 3px;\n    border-radius: 4px;\n  }\n\n  body[data-theme='ai'] :focus-visible {\n    outline-color: #A3D6FF;\n  }\n\n  h1,\n  h2,\n  h3,\n  h4 {\n    text-wrap: balance;\n  }\n\n  /*\n   * Thai typography.\n   *\n   * Thai has no inter-word spaces, so a browser will happily break a word in\n   * half at the end of a line. `word-break: keep-all` plus `line-break: normal`\n   * keeps Thai clusters intact; oversized headlines then wrap at phrase\n   * boundaries we control with explicit spans instead.\n   *\n   * Letter-spacing is reset to 0 on Thai text: the negative tracking that makes\n   * large Latin display type look tight collapses Thai vowel marks into the\n   * consonants they sit above.\n   */\n  :lang(th),\n  .font-thai {\n    word-break: keep-all;\n    line-break: normal;\n    overflow-wrap: break-word;\n  }\n\n  .thai-display,\n  .ai-scene-title {\n    /*\n     * Zero tracking, not negative. Negative letter-spacing is a Latin display\n     * trick; in Thai it pushes tone marks and vowel signs into the consonants\n     * they belong to, which is a large part of why the type read as hard.\n     */\n    letter-spacing: 0;\n    word-break: keep-all;\n    line-break: normal;\n    /* Thai ascenders and tone marks need vertical room the Latin scale omits. */\n    line-height: 1.22;\n    padding-block: 0.08em;\n  }\n\n  /*\n   * `.ai-private` is the ONLY switch into the A&I faces. Corporate pages never\n   * carry it, so PDA BLISS typography is untouche