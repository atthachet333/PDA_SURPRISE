# Backend runtime configuration
NODE_ENV=development
PORT=1369
HOST=0.0.0.0

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:1368,http://127.0.0.1:1368

# Lead storage: "file" writes newline delimited JSON to LEAD_STORE_PATH, "memory" keeps them in RAM only
LEAD_STORE=file
LEAD_STORE_PATH=./data/leads.jsonl

# Rate limiting for public write endpoints
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW=10 minutes

# Public config served to the frontend at /api/config/public.
# CANONICAL SOURCE: frontend/src/data/company.ts — keep these in sync with it.
COMPANY_EMAIL=pdablissoffice@gmail.com
COMPANY_PHONE=0638693614
COMPANY_LOCATION=กรุงเทพมหานคร ประเทศไทย

# Reserved for future integrations (do not commit real values)
# DATABASE_URL=postgresql://user:password@localhost:5432/pdabliss
# JWT_SECRET=
# SMTP_URL=
# LINE_NOTIFY_TOKEN=
