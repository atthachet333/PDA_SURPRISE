# ============================================================================
# PDA BLISS — backend runtime configuration
# ============================================================================
# Copy to .env and adjust. NEVER commit a real .env — it is gitignored.
# Every value here is a safe placeholder or a real non-secret default.

# ---------------------------------------------------------------- core ------
NODE_ENV=development
PORT=1369
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------- single origin ------
# PRODUCTION: set SERVE_FRONTEND=true so this process also serves the built
# frontend. The site and its API then share one origin, which means no CORS,
# no second public port, and one target for Cloudflare Tunnel.
# DEVELOPMENT: leave false — Vite serves the frontend on 1368 and proxies here.
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist

# ---------------------------------------------------------------- CORS ------
# Only used when SERVE_FRONTEND=false (i.e. the frontend is on another origin).
# In production the server refuses to start if this is still localhost-only
# while SERVE_FRONTEND is false.
CORS_ORIGIN=http://localhost:1368,http://127.0.0.1:1368

# --------------------------------------------------------------- proxy ------
# Number of proxy hops to trust for the client IP. Behind Cloudflare Tunnel the
# only hop is the local cloudflared process, so 1 is correct. Use 0 when the
# server is reached directly. Do NOT raise this "just in case": each extra hop
# is one more X-Forwarded-For entry a client could forge to dodge rate limits.
TRUST_PROXY_HOPS=1

# ------------------------------------------------------------ public URL ----
# OWNER INPUT REQUIRED before go-live. The public https origin, no trailing
# slash, e.g. https://pdabliss.com. Leave empty until the hostname is chosen.
PUBLIC_ORIGIN=

# --------------------------------------------------------------- limits -----
BODY_LIMIT_BYTES=65536
CONTACT_RATE_MAX=5
CONTACT_RATE_WINDOW=10 minutes

# ---------------------------------------------------------------- leads -----
# "file" writes newline-delimited JSON to LEAD_STORE_PATH, "memory" keeps them
# in RAM only (useful for smoke tests that must not persist anything).
LEAD_STORE=file
LEAD_STORE_PATH=./data/leads.jsonl

# -------------------------------------------------------------- company -----
# Served at /api/config/public. CANONICAL SOURCE: frontend/src/data/company.ts
# — keep these in sync with it. Not secrets: this is published contact detail.
COMPANY_EMAIL=pdablissoffice@gmail.com
COMPANY_PHONE=0638693614
COMPANY_LOCATION=กรุงเทพมหานคร ประเทศไทย

# Reserved for future integrations. Do not commit real values.
# DATABASE_URL=
# JWT_SECRET=
# SMTP_URL=
