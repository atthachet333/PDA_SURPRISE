# ============================================================================
# PDA BLISS — frontend build/dev configuration
# ============================================================================
# Anything prefixed VITE_ is EMBEDDED IN THE PUBLIC BUNDLE and readable by
# anyone. Never put a secret here.

# Where the dev/preview server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:1369

# Optional override for the API base used by the browser.
# Leave unset: it defaults to same-origin /api, which is what the production
# single-origin topology needs.
# VITE_API_BASE_URL=/api

# OWNER INPUT REQUIRED before go-live.
# The public https origin, no trailing slash, shape: https://<production-hostname>.
# Production (owner-confirmed, EP46.6): https://solution.pdabliss.com
# Used for canonical tags, og:url and sitemap.xml generation. While it is
# empty, canonical/og URLs are relative and no sitemap.xml is produced.
# Set this in frontend/.env.production for the production build.
# VITE_PUBLIC_ORIGIN=
